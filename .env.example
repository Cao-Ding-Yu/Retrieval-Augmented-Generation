# ============================================================================
# 本地开发配置（.env）
# 所有变量名与 src/rag_app/config.py 中 Settings 的字段名一一对应。
# ============================================================================

# ---------------------------- Ollama(本地模型服务) ----------------------------
OLLAMA_BASE_URL=http://localhost:11434
# 对话模型
CHAT_MODEL=qwen3.5:9b
# 嵌入模型
EMBEDDING_MODEL=qwen3-embedding:8b
# 嵌入维度必须与模型真实输出一致，否则写库会直接报维度不匹配。
#   qwen3-embedding:8b  -> 4096
EMBEDDING_DIM=4096

# ---------------------------- Milvus(向量数据库) ------------------------------
MILVUS_URI=http://localhost:19530
# 无鉴权留空
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_chunks_qwen3_4096_zh

# ---------------------------- 检索参数（RAG-Fusion）---------------------------
# 是否启用 RAG-Fusion
FUSION_ENABLED=true
# 额外生成的子问题数
FUSION_SUB_QUERIES=2
# 每个问题（含原问题）召回并保留的分块数
FUSION_RECALL_K=15
# RRF 融合常数
RRF_K=60

# 文本分析器类型
BM25_ANALYZER_TYPE=chinese
# 重排的候选数量
RERANK_TOP_N=20
# 重排后最终送给 LLM 的上下文条数
FINAL_TOP_K=5

# ---------------------------- 重排模型 ----------------------------------------
# 交叉编码器 bge-reranker-v2-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=true
# 重排模型运行设备
RERANKER_DEVICE=auto

# HuggingFace 缓存根目录
HF_HOME=C:/Users/xxxx/.cache/huggingface

# 优先以离线方式加载重排模型
RERANKER_OFFLINE_FIRST=true
# 本地缓存缺失时是否允许联网下载
RERANKER_ALLOW_DOWNLOAD=true

# ---------------------------- 文本切分 ----------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---------------------------- 生成参数 ----------------------------------------
TEMPERATURE=0.2
# 送入 LLM 的单条上下文最大字符数
MAX_CONTEXT_CHARS=10000
# 是否在网页上展示推理模型的思考过程
SHOW_THINKING=true

# ---------------------------- 服务 --------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# ---------------------------- 数据目录 ----------------------------------------
DATA_DIR=./data
